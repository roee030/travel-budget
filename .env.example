# ── Server ─────────────────────────────────────────────
PORT=4000
# Comma-separated list of allowed web origins (CORS)
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# ── AI (Anthropic / Claude) ────────────────────────────
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Model used to reason about options and build the itinerary.
ANTHROPIC_MODEL=claude-sonnet-5

# ── Flights ────────────────────────────────────────────
# Kiwi.com / Tequila API key (https://tequila.kiwi.com/)
KIWI_API_KEY=

# ── Hotels ─────────────────────────────────────────────
# Booking.com / RapidAPI or partner key
BOOKING_API_KEY=

# ── Places: restaurants, attractions, transport ────────
# Google Places API key (https://developers.google.com/maps/documentation/places/web-service)
GOOGLE_PLACES_API_KEY=

# ── Live insights: forums, reviews, "what's hot" (RAG) ──
# SerpAPI key for Google/Reddit/news results (https://serpapi.com/)
SERPAPI_KEY=

# ── Vector store (RAG retrieval) ───────────────────────
# One of: memory | pinecone | chroma   (default: memory)
VECTOR_STORE=memory
PINECONE_API_KEY=
PINECONE_INDEX=trip-insights
CHROMA_URL=http://localhost:8000

# ── Cache ──────────────────────────────────────────────
# Redis connection string. Leave empty to use an in-memory cache.
REDIS_URL=
# Default TTL for cached provider/AI results, in seconds.
CACHE_TTL_SECONDS=86400

# ── Database (saved trips, profiles, history) ──────────
# PostgreSQL connection string. Leave empty to use an in-memory store.
DATABASE_URL=

# When true, every provider returns curated sample data instead of
# calling external APIs. Providers also fall back to samples per-provider
# whenever their own key is missing.
USE_SAMPLE_DATA=false
